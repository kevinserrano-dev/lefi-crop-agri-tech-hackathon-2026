# LEFI CROP — configuration template. `scripts/install.sh` copies it to `.env` (git-ignored,
# chmod 600) and fills in the values for the roles installed on this machine.
# Never commit `.env`. Runtime state (credentials, broker config, logs, DB) lives in ~/.lefi-crop/.

# Roles installed on this machine (ai, core, admin, robot, firmware) — managed by the installer.
LEFI_ROLES=

# ---------- AI node ----------
# 127.0.0.1:11434 when the Brain runs here; 0.0.0.0:11434 to serve a core node on the LAN.
LEFI_AI_BIND=127.0.0.1:11434
# Clients allowed to use Ollama; others are flagged by `lefi ai requests|connections`.
# Add the main PC's LAN address when the AI node is another PC, e.g. "127.0.0.1 <main-pc-ip>".
LEFI_AI_ALLOWED_CLIENTS=127.0.0.1

# ---------- Brain / core node ----------
LEFI_ENV=production
LEFI_API_HOST=0.0.0.0
LEFI_API_PORT=8000
LEFI_DATABASE_URL=
LEFI_CORS_ORIGINS=
LEFI_JWT_SECRET=
LEFI_BOOTSTRAP_ADMIN_USERNAME=admin
LEFI_BOOTSTRAP_ADMIN_PASSWORD=
LEFI_MQTT_HOST=127.0.0.1
LEFI_MQTT_PORT=1883
LEFI_MQTT_USERNAME=lefi-brain
LEFI_MQTT_PASSWORD=
# Freshness: older readings are STALE and never treated as current.
LEFI_STALE_AFTER_S=90
LEFI_DEVICE_OFFLINE_AFTER_S=120

# Local AI used by the Brain. OLLAMA_MODEL must be a tag from config/supported-models.tsv
# that appears in `ollama list` on the AI node; otherwise AI is reported unavailable.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT=90
OLLAMA_MAX_CONCURRENT_REQUESTS=1

# Robotics (simulation only in this release)
LEFI_ROBOT_ADAPTER=mock
LEFI_AUTO_INSPECTION=true

# Written by the installer (ADR-028, ADR-029): how services run here, and whether this
# node meets the AI requirement ("passed …" / "override …" in development only).
LEFI_SERVICE_MODE=
LEFI_AI_GATE=

# ---------- Admin node ----------
LEFI_ADMIN_URL=
LEFI_ADMIN_BRAIN_UPSTREAM=127.0.0.1:8000
