    "allow-scan-hardware",
    "allow-preview-plan",
    "allow-run-install",
    "allow-install-session",
    "allow-check-ai-node",
    "allow-run-check",
    "allow-cancel-install",
    "allow-run-rollback",
    "allow-run-brain-update",
    "allow-fleet-status",
    "allow-fleet-start-service",
    "allow-fleet-stop-service",
    "allow-console-state",
    "allow-read-credentials",
    "allow-finish-setup",
    "allow-change-admin-password",
    "allow-system-status",
    "allow-remove-component",
    "allow-uninstall-everything",
    "allow-erase-plan",
    "allow-erase-nodes",
    "allow-erase-this-pc",
    "allow-quit-and-remove-helper",
    "allow-create-pairing-code",
