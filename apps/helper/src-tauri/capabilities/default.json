    "allow-apply-helper-update",
    "allow-update-settings",
    "allow-set-update-settings",
    "allow-backup-status",
    "allow-backup-disks",
    "allow-backup-list",
    "allow-backup-set-disk",
    "allow-backup-schedule",
    "allow-backup-run-now",
    "allow-backup-restore",
    "notification:default"
  ]
}
