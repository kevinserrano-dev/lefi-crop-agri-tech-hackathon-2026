{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.leficrop.local/mqtt/telemetry.v1.schema.json",
  "title": "Device telemetry v1",
  "description": "Topic lefi/v1/devices/{device_id}/telemetry. QoS 1, not retained. One message per read cycle with every channel the firmware read. Values are identified only by sensor_key + variable; Lefi Brain maps each sensor to its plant, container, zone or device (ADR-052), so the firmware never knows plants. A failed read is sent as value null with an error, never as a guessed value. Lefi Brain stamps received_at (ADR-008).",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "device_id", "boot_id", "seq", "uptime_ms", "origin", "readings"],
  "properties": {
    "v": { "const": 1 },
    "device_id": { "$ref": "common.v1.schema.json#/$defs/device_id" },
    "boot_id": { "$ref": "common.v1.schema.json#/$defs/boot_id" },
    "seq": { "$ref": "common.v1.schema.json#/$defs/seq" },
    "uptime_ms": { "$ref": "common.v1.schema.json#/$defs/uptime_ms" },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "Device clock, only when ts_synced is true. Informative: freshness uses Lefi Brain time."
    },
    "ts_synced": { "type": "boolean", "default": false },
    "origin": { "$ref": "common.v1.schema.json#/$defs/origin" },
    "readings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sensor_key", "variable", "value"],
        "properties": {
          "sensor_key": { "$ref": "common.v1.schema.json#/$defs/sensor_key" },
          "variable": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,40}$" },
          "value": { "type": ["number", "null"] },
          "error": {
            "enum": ["not_detected", "read_failed", "out_of_range", "crc"],
            "description": "Present when value is null."
          }
        },
        "if": { "properties": { "value": { "type": "null" } } },
        "then": { "required": ["error"] }
      }
    }
  }
}
